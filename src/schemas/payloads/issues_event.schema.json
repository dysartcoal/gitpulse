{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IssuesEvent payload",
  "type": "object",
  "required": ["action", "issue"],
  "properties": {
    "action": { "type": "string" },
    "issue": {
      "type": "object",
      "required": ["id", "number", "title", "state"],
      "properties": {
        "id": { "type": "integer" },
        "number": { "type": "integer" },
        "title": { "type": "string" },
        "state": { "type": "string" }
      }
    }
  }
}
