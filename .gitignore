# --- Secrets & credentials (never commit these) ---
.env
.env.*
*.pem
*.key
credentials.json
accessKeys.csv
credentials.csv
.aws-credentials
secrets.tfvars
*.secrets.yaml

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node (if any tooling needs it) ---
node_modules/

# --- Docker ---
*.pid

# --- Apache NiFi (local flow files can embed sensitive config) ---
conf/flow.xml.gz
conf/flow.json.gz
conf/*.password

# --- dbt ---
target/
dbt_packages/
logs/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store

# --- Phase 1 runtime pipeline output (raw/quarantine stores) ---
# Local raw/ and quarantine/ stores the consumer writes at runtime - documented
# as gitignored in plan.md's Project Structure, added here to actually match.
/data/

# --- Exploration output (investigations & scratch) ---
# Ad hoc/exploratory work and manual test output that isn't part of the shipped
# project or the formal pytest suite - see exploration/README.md. Only the
# README.md guide at each level is tracked; everything else here is disposable
# or evidence-only and shouldn't live in git history.
/exploration/investigations/*
!/exploration/investigations/README.md
/exploration/scratch/*
!/exploration/scratch/README.md
