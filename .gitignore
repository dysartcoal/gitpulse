# --- Secrets & credentials (never commit these) ---
.env
.env.*
*.pem
*.key
credentials.json
accessKeys.csv
credentials.csv
.aws-credentials
secrets.tfvars
*.secrets.yaml

# --- Terraform ---
.terraform/
